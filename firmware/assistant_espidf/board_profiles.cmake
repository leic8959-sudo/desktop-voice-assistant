# Native implementations only. The upstream inventory does not authorize a build.
file(READ "${CMAKE_CURRENT_LIST_DIR}/native_board_profiles.json" ASSISTANT_PROFILE_JSON)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/native_board_profiles.json")
string(JSON ASSISTANT_PROFILE_SCHEMA GET "${ASSISTANT_PROFILE_JSON}" schema_version)
if(NOT ASSISTANT_PROFILE_SCHEMA EQUAL 1)
    message(FATAL_ERROR "Unsupported native board profile schema")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/.assistant-board")
    file(READ "${CMAKE_CURRENT_LIST_DIR}/.assistant-board" ASSISTANT_VOLUME_BOARD)
    string(STRIP "${ASSISTANT_VOLUME_BOARD}" ASSISTANT_VOLUME_BOARD)
    if(DEFINED ASSISTANT_BOARD AND NOT ASSISTANT_BOARD STREQUAL ASSISTANT_VOLUME_BOARD)
        message(FATAL_ERROR "Selected board differs from the isolated build volume")
    endif()
    set(ASSISTANT_BOARD "${ASSISTANT_VOLUME_BOARD}")
elseif(NOT DEFINED ASSISTANT_BOARD)
    set(ASSISTANT_BOARD "waveshare-amoled-1.8")
endif()
string(JSON ASSISTANT_PROFILE_TYPE ERROR_VARIABLE ASSISTANT_PROFILE_ERROR TYPE "${ASSISTANT_PROFILE_JSON}" profiles "${ASSISTANT_BOARD}")
if(NOT ASSISTANT_PROFILE_ERROR STREQUAL "NOTFOUND" OR NOT ASSISTANT_PROFILE_TYPE STREQUAL "OBJECT")
    message(FATAL_ERROR "No native implementation registered for ASSISTANT_BOARD=${ASSISTANT_BOARD}")
endif()
string(JSON ASSISTANT_PROJECT_NAME GET "${ASSISTANT_PROFILE_JSON}" profiles "${ASSISTANT_BOARD}" project_name)
string(JSON ASSISTANT_BSP_COMPONENT GET "${ASSISTANT_PROFILE_JSON}" profiles "${ASSISTANT_BOARD}" bsp_component)
string(JSON ASSISTANT_BOARD_TARGET GET "${ASSISTANT_PROFILE_JSON}" profiles "${ASSISTANT_BOARD}" target)
string(JSON ASSISTANT_FLASH_SIZE_MB GET "${ASSISTANT_PROFILE_JSON}" profiles "${ASSISTANT_BOARD}" flash_size_mb)
if(NOT ASSISTANT_FLASH_SIZE_MB MATCHES "^(4|8|16|32)$")
    message(FATAL_ERROR "Native flash capacity has not been implemented")
endif()
string(LENGTH "${ASSISTANT_PROJECT_NAME}" ASSISTANT_PROJECT_NAME_LENGTH)
if(NOT ASSISTANT_PROJECT_NAME MATCHES "^[a-z][a-z0-9_]*$" OR ASSISTANT_PROJECT_NAME_LENGTH GREATER 31 OR NOT ASSISTANT_BSP_COMPONENT MATCHES "^[a-z0-9_-]+$")
    message(FATAL_ERROR "Invalid native project/component identity")
endif()
if(NOT ASSISTANT_BOARD_TARGET MATCHES "^(esp32s3|esp32p4|esp32s31|esp32c5)$")
    message(FATAL_ERROR "Current native engine has source ports for ESP32-S3, ESP32-P4, ESP32-S31 and the reviewed ESP32-C5 board only")
endif()
string(JSON ASSISTANT_DEFINITION_COUNT LENGTH "${ASSISTANT_PROFILE_JSON}" profiles "${ASSISTANT_BOARD}" compile_definitions)
if(ASSISTANT_DEFINITION_COUNT LESS 1)
    message(FATAL_ERROR "Native board profile has no implementation macro")
endif()
math(EXPR ASSISTANT_DEFINITION_LAST "${ASSISTANT_DEFINITION_COUNT} - 1")
set(ASSISTANT_BOARD_DEFINITION)
foreach(ASSISTANT_DEFINITION_INDEX RANGE ${ASSISTANT_DEFINITION_LAST})
    string(JSON ASSISTANT_DEFINITION GET "${ASSISTANT_PROFILE_JSON}" profiles "${ASSISTANT_BOARD}" compile_definitions ${ASSISTANT_DEFINITION_INDEX})
    if(NOT ASSISTANT_DEFINITION MATCHES "^ASSISTANT_BOARD_[A-Z0-9_]+=1$")
        message(FATAL_ERROR "Invalid native implementation macro")
    endif()
    list(APPEND ASSISTANT_BOARD_DEFINITION "${ASSISTANT_DEFINITION}")
endforeach()
