CONFIG_CODEC_ES8389_SUPPORT=y
CONFIG_CODEC_ES8311_SUPPORT=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=2
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
