CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPI_FLASH_FREQ_LIMIT_C5_240MHZ=y
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y
# UART0 TX11/RX12 collide with I2S BCLK11/DIN12; USB uses13/14.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
